# Every variable the service reads, with its default (D§9).
# Copy to .env only if you want to override something; `npm start` picks it up
# through Node's --env-file-if-exists. There is no dotenv dependency (D-012).

PORT=4000
# Loopback by default; the container sets 0.0.0.0 so a published port reaches it.
HOST=127.0.0.1
DB_PATH=./data/app.db
# A GraphQL request is a few hundred bytes. Anything near this is not a client (D-028).
MAX_BODY_BYTES=32768

OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
HTTP_TIMEOUT_MS=5000

# How long a stored snapshot counts as fresh.
WEATHER_TTL_HOURS=3
MARINE_TTL_HOURS=6
# Inland locations have no wave model; re-check weekly rather than every request.
MARINE_UNAVAILABLE_TTL_HOURS=168
# Past this, refresh inline instead of serving stale.
MAX_STALE_HOURS=24

GEOCODE_TTL_DAYS=30
GEOCODE_MISS_TTL_HOURS=24

REFRESH_ENABLED=true
REFRESH_INTERVAL_MINUTES=10
REFRESH_ACTIVE_WINDOW_HOURS=24
# Most towns one cycle will refresh, newest first (D-028).
REFRESH_MAX_LOCATIONS=200
SNAPSHOT_RETENTION_HOURS=48

LOG_LEVEL=info
